Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Datasource
Bundle-SymbolicName: datasource.factory
Bundle-Version: 2.0.0
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=21))"
Bundle-ActivationPolicy: lazy
Import-Package: jakarta.transaction;version="[2.0,3)",
 javax.management,
 javax.sql,
 javax.transaction.xa,
 org.osgi.framework;version="[1.8,2)",
 org.osgi.service.cm;version="[1.5,2)"
DynamicImport-Package: *
Service-Component: OSGI-INF/datasource.DataSourceProvider.xml,
 OSGI-INF/datasource.TransactionalDataSourceProvider.xml
Bundle-ClassPath: .,
 lib/commons-dbcp2.jar,
 lib/commons-pool2.jar,
 lib/commons-logging.jar,
 lib/javax.transaction-api.jar
