<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <!-- JTA unit: data source from the "XAdatasource" factory with property name=sample-jta. -->
    <persistence-unit name="sample-jta" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>osgi:service/javax.sql.DataSource/(name=sample-jta)</jta-data-source>
        <class>sample.impl.Item</class>
        <exclude-unlisted-classes/>
        <properties>
            <property name="eclipselink.ddl-generation" value="drop-and-create-tables"/>
            <property name="eclipselink.weaving" value="false"/>
        </properties>
    </persistence-unit>
    <!-- Resource local unit: data source from the "datasource" factory with property name=sample-local. -->
    <persistence-unit name="sample-local" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <non-jta-data-source>osgi:service/javax.sql.DataSource/(name=sample-local)</non-jta-data-source>
        <class>sample.impl.Item</class>
        <exclude-unlisted-classes/>
        <properties>
            <property name="eclipselink.ddl-generation" value="drop-and-create-tables"/>
            <property name="eclipselink.weaving" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
