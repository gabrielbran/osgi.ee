Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: JEE CDI extender
Bundle-SymbolicName: osgi.ee.extender.cdi
Bundle-Version: 2.0.0
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=21))"
Provide-Capability: osgi.extender;osgi.extender="osgi.cdi";version:Version="2.0"
Export-Package: osgi.cdi.annotation;version="2.0.0",
 osgi.cdi.faces;version="2.0.0";
