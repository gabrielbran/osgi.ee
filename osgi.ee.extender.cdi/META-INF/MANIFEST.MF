 jakarta.enterprise.inject.spi;version="[4.1,5)",
 jakarta.enterprise.inject.spi.configurator;version="[4.1,5)",
 jakarta.enterprise.inject.spi.el;version="[4.1,5)",
 jakarta.enterprise.invoke;version="[4.1,5)",
 jakarta.enterprise.lang.model;version="[4.1,5)",
 jakarta.enterprise.lang.model.declarations;version="[4.1,5)",
 jakarta.enterprise.lang.model.types;version="[4.1,5)",
 jakarta.enterprise.util;version="[4.1,5)",
 jakarta.faces;version="[4.0,5)";resolution:=optional,
 jakarta.faces.application;version="[4.0,5)";resolution:=optional,
 jakarta.faces.component;version="[4.0,5)";resolution:=optional,
 jakarta.faces.context;version="[4.0,5)";resolution:=optional,
 jakarta.faces.event;version="[4.0,5)";resolution:=optional,
 jakarta.faces.validator;version="[4.0,5)";resolution:=optional,
 jakarta.inject;version="[2.0,3)",
 jakarta.interceptor;version="[2.0,3)",
 jakarta.persistence;resolution:=optional,
 jakarta.servlet;version="[6.0,7)",
 jakarta.servlet.descriptor;version="[6.0,7)";resolution:=optional,
 jakarta.servlet.http;version="[6.0,7)",
