Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: JEE CDI extender
Bundle-SymbolicName: osgi.ee.extender.cdi
Bundle-Version: 2.0.0
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=21))"
Provide-Capability: osgi.extender;osgi.extender="osgi.cdi";version:Version="2.0"
Export-Package: osgi.cdi.annotation;version="2.0.0",
 osgi.cdi.faces;version="2.0.0";
  uses:="org.osgi.framework,
   jakarta.faces.application,
   jakarta.el,
   jakarta.faces.context",
 osgi.extender.cdi.scopes;version="2.0.0";uses:="jakarta.servlet,jakarta.servlet.http",
 osgi.extender.resource;version="2.0.0",
 osgi.jta.faces;version="2.0.0"
Import-Package: jakarta.annotation;version="[2.0,4)",
 jakarta.el;version="[5.0,7)",
 jakarta.enterprise.context;version="[4.0,5)",
 jakarta.enterprise.context.spi;version="[4.0,5)",
 jakarta.enterprise.event;version="[4.0,5)",
 jakarta.enterprise.inject;version="[4.0,5)",
 jakarta.enterprise.inject.spi;version="[4.0,5)",
 jakarta.faces;version="[4.0,5)";resolution:=optional,
 jakarta.faces.application;version="[4.0,5)";resolution:=optional,
 jakarta.faces.component;version="[4.0,5)";resolution:=optional,
 jakarta.faces.context;version="[4.0,5)";resolution:=optional,
 jakarta.faces.event;version="[4.0,5)";resolution:=optional,
 jakarta.faces.validator;version="[4.0,5)";resolution:=optional,
 jakarta.inject;version="[2.0,3)",
 jakarta.interceptor;version="[2.0,3)",
 jakarta.servlet;version="[6.0,7)",
 jakarta.servlet.http;version="[6.0,7)",
 jakarta.transaction;version="[2.0,3)",
 org.jboss.weld.bootstrap;version="[6.0,7)",
 org.jboss.weld.bootstrap.api;version="[6.0,7)",
 org.jboss.weld.bootstrap.api.helpers;version="[6.0,7)",
 org.jboss.weld.bootstrap.spi;version="[6.0,7)",
 org.jboss.weld.ejb.spi;version="[6.0,7)",
 org.jboss.weld.manager;version="[6.0,7)",
 org.jboss.weld.resources.spi;version="[6.0,7)",
 org.jboss.weld.serialization.spi;version="[6.0,7)",
 org.osgi.framework;version="[1.8,2)",
 org.osgi.framework.wiring;version="[1.2,2)",
 org.osgi.util.tracker;version="[1.5,2)"
Bundle-Activator: osgi.extender.Activator
