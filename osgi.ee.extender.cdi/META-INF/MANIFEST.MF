   jakarta.faces.application,
   jakarta.el,
   jakarta.faces.context",
 osgi.extender.cdi.scopes;version="2.0.0";uses:="jakarta.servlet,jakarta.servlet.http",
 osgi.extender.resource;version="2.0.0",
 osgi.jta.faces;version="2.0.0"
Import-Package: jakarta.annotation;version="[2.0,4)",
 jakarta.decorator;version="[4.1,5)",
 jakarta.ejb;resolution:=optional,
 jakarta.el;version="[5.0,7)",
 jakarta.enterprise.context;version="[4.1,5)",
 jakarta.enterprise.context.control;version="[4.1,5)",
 jakarta.enterprise.context.spi;version="[4.1,5)",
