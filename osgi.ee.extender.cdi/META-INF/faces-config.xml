<?xml version="1.0"?>
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_1.xsd"
	version="4.1">
   <factory>
      <application-factory>osgi.cdi.faces.CdiApplicationFactory</application-factory>
      <exception-handler-factory>osgi.jta.faces.JtaExceptionHandlerFactory</exception-handler-factory>
   </factory>
   <application>
     <view-handler>osgi.cdi.faces.ViewScopeViewHandler</view-handler>
     <resource-handler>osgi.cdi.faces.BundleResourceHandler</resource-handler>
   </application>
</faces-config>
